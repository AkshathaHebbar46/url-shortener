# Copy to /etc/shortener/shortener.env, fill in, then:
#   sudo chmod 600 /etc/shortener/shortener.env

# The public address of THIS server. Must be right, or every shortUrl you hand
# out points at localhost. Also what SafeUrlValidator refuses to shorten, so
# the service cannot be pointed at itself.
SHORTENER_BASE_URL=http://your-host-or-ip

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/shortener
SPRING_DATASOURCE_USERNAME=shortener
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6380

# Tighten these for a public box — the defaults are dev-friendly, not safe.
SHORTENER_RATE_LIMIT_SHORTEN_PER_MINUTE=10
SHORTENER_RATE_LIMIT_REDIRECT_PER_MINUTE=100
