build/
!gradle/wrapper/gradle-wrapper.jar
.gradle/

.idea/
*.iml
*.ipr
*.iws
.vscode/

.DS_Store
*.log

# Load-test RAW output: hundreds of MB, regenerable, useless in review.
# The write-ups in loadtest/results/*.md are the artefact worth keeping, so
# this ignores the data files rather than the whole directory.
*.jtl
*.hprof
loadtest/results/*-report/

# Generated by seed.sh against a specific database; stale the moment the
# database is reset, and misleading if committed.
loadtest/codes.csv

# Real credentials live here on a server. The .example file is committed.
deploy/shortener.env
